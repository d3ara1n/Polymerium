<husk:Page
    x:Class="Polymerium.Avalonia.Pages.RecipesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fi="using:FluentIcons.Avalonia"
    xmlns:fie="clr-namespace:FluentIcons.Avalonia.Markup;assembly=FluentIcons.Avalonia"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:lang="https://github.com/d3ara1n/Polymerium/Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="app:RecipesPageModel"
    mc:Ignorable="d">
    <husk:Page.Header>
        <DockPanel HorizontalSpacing="8">
            <TextBlock
                Text="{x:Static lang:Resources.RecipesPage_Title}"
                Theme="{StaticResource PageHeaderTextBlockTheme}" />
        </DockPanel>
    </husk:Page.Header>
    <DockPanel>
        <Grid
            DockPanel.Dock="Top"
            Margin="0,0,0,8"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Command="{Binding ImportCommand}"
                    Theme="{StaticResource GhostButtonTheme}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <fi:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="{StaticResource MediumFontSize}"
                            Symbol="ArrowImport" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.RecipesPage_ImportButtonText}" />
                    </StackPanel>
                </Button>
                <Button
                    Classes="Primary"
                    Command="{Binding NewCommand}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="7">
                        <fi:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="{StaticResource MediumFontSize}"
                            Symbol="Add" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.RecipesPage_NewButtonText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Panel>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding Items.Count, Converter={x:Static husk:NumberConverters.IsZero}}"
                Spacing="12">
                <fi:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource ExtraLargeFontSize}"
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                    Symbol="Bookmark" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource LargeFontSize}"
                    Text="{x:Static lang:Resources.RecipesPage_EmptyTitleText}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                    Text="{x:Static lang:Resources.RecipesPage_EmptySubtitleText}" />
                <Button
                    HorizontalAlignment="Center"
                    Classes="Primary"
                    Command="{Binding NewCommand}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="7">
                        <fi:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="{StaticResource MediumFontSize}"
                            Symbol="Add" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.RecipesPage_NewButtonText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ScrollViewer IsVisible="{Binding Items.Count, Converter={x:Static husk:NumberConverters.IsNonZero}}">
                <ItemsControl
                    Padding="4"
                    ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel
                                ItemSpacing="8"
                                LineSpacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:RecipeCardModel">
                            <Button
                                Width="260"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Command="{Binding $parent[app:RecipesPage].((app:RecipesPageModel)DataContext).OpenCommand, FallbackValue={x:Null}}"
                                CommandParameter="{Binding}"
                                Theme="{StaticResource OutlineButtonTheme}">
                                <Border Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            FontSize="{StaticResource LargeFontSize}"
                                            FontWeight="{StaticResource ControlStrongFontWeight}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            MaxLines="2"
                                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                            Text="{Binding Description}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <fi:SymbolIcon
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource SmallFontSize}"
                                                Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                Symbol="BoxMultiple" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource SmallFontSize}"
                                                Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                Text="{Binding ItemCount}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource SmallFontSize}"
                                                Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                Text="{x:Static lang:Resources.RecipesPage_ItemCountSuffix}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem
                                            Command="{Binding $parent[app:RecipesPage].((app:RecipesPageModel)DataContext).OpenCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static lang:Resources.RecipesPage_OpenMenuText}"
                                            Icon="{fie:SymbolIcon Symbol=Open,
                                                                  FontSize={StaticResource MediumFontSize}}" />
                                        <MenuItem
                                            Command="{Binding $parent[app:RecipesPage].((app:RecipesPageModel)DataContext).ExportCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static lang:Resources.RecipesPage_ExportMenuText}"
                                            Icon="{fie:SymbolIcon Symbol=ArrowExport,
                                                                  FontSize={StaticResource MediumFontSize}}" />
                                        <MenuItem Header="-" />
                                        <MenuItem
                                            Command="{Binding $parent[app:RecipesPage].((app:RecipesPageModel)DataContext).DeleteCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}"
                                            Header="{x:Static lang:Resources.RecipesPage_DeleteMenuText}"
                                            Icon="{fie:SymbolIcon Symbol=Delete,
                                                                  FontSize={StaticResource MediumFontSize}}" />
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</husk:Page>
