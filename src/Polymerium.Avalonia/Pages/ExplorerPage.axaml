<app:ScopedPage
    x:Class="Polymerium.Avalonia.Pages.ExplorerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:fie="clr-namespace:FluentIcons.Avalonia.Markup;assembly=FluentIcons.Avalonia"
    xmlns:fic="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:TridentCore.Abstractions.Repositories.Resources;assembly=TridentCore.Abstractions"
    Padding="0"
    d:DesignHeight="450"
    d:DesignWidth="600"
    x:DataType="app:ExplorerPageModel"
    IsHeaderVisible="False"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    mc:Ignorable="d">
    <app:ScopedPage.Resources>
        <MenuFlyout
            x:Key="ExhibitPackageButtonFlyout"
            x:DataType="app:ExhibitModel">
            <MenuItem
                Command="{Binding $parent[app:ExplorerPage].((app:ExplorerPageModel)DataContext).InstallPackageCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding}"
                Header="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_InstallMenuText}}"
                Icon="{fie:SymbolIcon Symbol=ArrowDownload,
                                      FontSize={StaticResource MediumFontSize}}" />
            <MenuItem
                Command="{Binding $parent[app:ExplorerPage].((app:ExplorerPageModel)DataContext).FavoritePackageCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding}"
                Header="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_FavoriteMenuText}}"
                Icon="{fie:SymbolIcon Symbol=CollectionsAdd,
                                      FontSize={StaticResource MediumFontSize}}"
                IsChecked="{Binding IsFavorite, Mode=OneWay}"
                ToggleType="CheckBox" />
            <MenuItem Header="-" />
            <MenuItem
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding Label, FallbackValue=Repository}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock
                            Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_RepositoryMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding Label, FallbackValue=Repository}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding Namespace, FallbackValue=Namespace}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock
                            Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_NamespaceMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding Namespace, FallbackValue=Namespace}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding ProjectName, FallbackValue=Project Name}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock
                            Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ProjectNameMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding ProjectName, FallbackValue=Project Name}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding ProjectId, FallbackValue=Pid}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock
                            Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ProjectIdMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding ProjectId, FallbackValue=Pid}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="-" />
            <MenuItem
                Command="{x:Static app:InternalCommands.OpenUriCommand}"
                CommandParameter="{Binding Reference, FallbackValue={x:Null}}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_OpenWebsiteMenuText}}"
                Icon="{fie:SymbolIcon Symbol=Open,
                                      FontSize={StaticResource MediumFontSize}}" />
        </MenuFlyout>
        <MenuFlyout
            x:Key="ExhibitPendingPackageButtonFlyout"
            x:DataType="app:ExhibitModel">
            <MenuItem
                Command="{Binding $parent[app:ExplorerPage].((app:ExplorerPageModel)DataContext).FavoritePackageCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding}"
                Header="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_FavoriteMenuText}}"
                Icon="{fie:SymbolIcon Symbol=CollectionsAdd,
                                      FontSize={StaticResource MediumFontSize}}"
                IsChecked="{Binding IsFavorite, Mode=OneWay}"
                ToggleType="CheckBox" />
            <MenuItem Header="-" />
            <MenuItem
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding ProjectName, FallbackValue=Project Name}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock
                            Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ProjectNameMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding ProjectName, FallbackValue=Project Name}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding ProjectId, FallbackValue=Pid}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock
                            Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ProjectIdMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding ProjectId, FallbackValue=Pid}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding Label, FallbackValue=Repository}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock
                            Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_RepositoryMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding Label, FallbackValue=Repository}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding Namespace, FallbackValue=Namespace}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock
                            Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_NamespaceMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding Namespace, FallbackValue=Namespace}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="-" />
            <MenuItem
                Command="{x:Static app:InternalCommands.OpenUriCommand}"
                CommandParameter="{Binding Reference, FallbackValue={x:Null}}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_OpenWebsiteMenuText}}"
                Icon="{fie:SymbolIcon Symbol=Open,
                                      FontSize={StaticResource MediumFontSize}}" />
            <MenuItem Header="-" />
            <MenuItem
                Command="{Binding $parent[app:ExplorerPage].((app:ExplorerPageModel)DataContext).RemoveFromPendingCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding}"
                Header="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_RemoveFromPendingMenuText}}"
                Icon="{fie:SymbolIcon Symbol=Delete,
                                      FontSize={StaticResource MediumFontSize}}" />
        </MenuFlyout>
        <DataTemplate
            x:Key="ExhibitModelTemplate"
            x:DataType="app:ExhibitModel">
            <app:ExhibitPendingPackageButton
                Command="{Binding $parent[app:ExplorerPage].((app:ExplorerPageModel)DataContext).ViewPackageCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding}"
                ContextFlyout="{StaticResource ExhibitPendingPackageButtonFlyout}" />
        </DataTemplate>
    </app:ScopedPage.Resources>
    <!--  MenuItem.Icon 只收数据：Symbol 枚举经此隐式模板渲染为图标，落入菜单模板的图标槽  -->
    <app:ScopedPage.DataTemplates>
        <DataTemplate x:DataType="fic:Symbol">
            <fi:SymbolIcon
                FontSize="{StaticResource MediumFontSize}"
                Symbol="{Binding}" />
        </DataTemplate>
    </app:ScopedPage.DataTemplates>
    <Grid
        ColumnDefinitions="Auto,Auto,*"
        RowDefinitions="Auto,Auto,*">
        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="12">
            <Border
                Grid.Row="0"
                Margin="12"
                Padding="12,6"
                Background="{StaticResource ControlTranslucentHalfBackgroundBrush}"
                CornerRadius="{StaticResource MediumCornerRadius}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6">
                    <fi:SymbolIcon
                        FontSize="{StaticResource LargeFontSize}"
                        Symbol="Drawer" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_PendingLabelText}}" />
                </StackPanel>
            </Border>
            <ScrollViewer
                Grid.Row="1"
                Padding="12,0">
                <StackPanel Spacing="8">
                    <husk:Divider>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_AddLabelText}}" />
                        </StackPanel>
                    </husk:Divider>
                    <Panel>
                        <TextBlock
                            Margin="8"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding AddingPackagesView.Count, Mode=OneWay, Converter={x:Static husk:NumberConverters.IsZero}, FallbackValue=False}"
                            Opacity="0.5"
                            Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_EmptyLabelText}}" />
                        <ItemsControl
                            ClipToBounds="False"
                            ItemTemplate="{StaticResource ExhibitModelTemplate}"
                            ItemsSource="{Binding AddingPackagesView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Panel>
                    <husk:Divider>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock
                                Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_ModifyLabelText}}" />
                        </StackPanel>
                    </husk:Divider>
                    <Panel>
                        <TextBlock
                            Margin="8"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding ModifyingPackagesView.Count, Mode=OneWay, Converter={x:Static husk:NumberConverters.IsZero}, FallbackValue=False}"
                            Opacity="0.5"
                            Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_EmptyLabelText}}" />
                        <ItemsControl
                            ClipToBounds="False"
                            ItemTemplate="{StaticResource ExhibitModelTemplate}"
                            ItemsSource="{Binding ModifyingPackagesView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Panel>
                    <husk:Divider>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock
                                Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_RemoveLabelText}}" />
                        </StackPanel>
                    </husk:Divider>
                    <Panel>
                        <TextBlock
                            Margin="8"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding RemovingPackagesView.Count, Mode=OneWay, Converter={x:Static husk:NumberConverters.IsZero}, FallbackValue=False}"
                            Opacity="0.5"
                            Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_EmptyLabelText}}" />
                        <ItemsControl
                            ClipToBounds="False"
                            ItemTemplate="{StaticResource ExhibitModelTemplate}"
                            ItemsSource="{Binding RemovingPackagesView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Panel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel
                Grid.Row="2"
                Margin="12"
                Spacing="10">
                <husk:SwitchContainer
                    TargetType="x:Boolean"
                    Value="{Binding HasSecondaryActions, FallbackValue=False}">
                    <husk:SwitchCase Value="{x:True}">
                        <SplitButton
                            Classes="Primary"
                            Padding="12,6"
                            Command="{Binding CollectCommand}">
                            <SplitButton.Flyout>
                                <MenuFlyout ItemsSource="{Binding SecondaryActions}">
                                    <MenuFlyout.ItemContainerTheme>
                                        <ControlTheme
                                            BasedOn="{StaticResource {x:Type MenuItem}}"
                                            TargetType="MenuItem"
                                            x:DataType="app:ExplorerActionItemModel">
                                            <Setter Property="Command" Value="{Binding Command}" />
                                            <Setter Property="Icon" Value="{Binding Icon}" />
                                            <Setter Property="Header" Value="{Binding LangKey}" />
                                            <Setter Property="HeaderTemplate">
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{app:LocalizedKey {Binding}}" />
                                                </DataTemplate>
                                            </Setter>
                                        </ControlTheme>
                                    </MenuFlyout.ItemContainerTheme>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <fi:SymbolIcon
                                    FontSize="{StaticResource LargeFontSize}"
                                    Symbol="{Binding PrimaryAction.Icon}" />
                                <TextBlock Text="{app:LocalizedKey {Binding PrimaryAction.LangKey}}" />
                            </StackPanel>
                        </SplitButton>
                    </husk:SwitchCase>
                    <husk:SwitchCase Value="{x:False}">
                        <Button
                            Classes="Primary"
                            Padding="12,6"
                            Command="{Binding CollectCommand}"
                            CornerRadius="{StaticResource MediumCornerRadius}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <fi:SymbolIcon
                                    FontSize="{StaticResource LargeFontSize}"
                                    Symbol="{Binding PrimaryAction.Icon}" />
                                <TextBlock Text="{app:LocalizedKey {Binding PrimaryAction.LangKey}}" />
                            </StackPanel>
                        </Button>
                    </husk:SwitchCase>
                </husk:SwitchContainer>
                <Button
                    Padding="12,6"
                    Command="{Binding DismissPendingCommand}"
                    CornerRadius="{StaticResource MediumCornerRadius}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <fi:SymbolIcon
                            FontSize="{StaticResource LargeFontSize}"
                            Symbol="DrawerDismiss" />
                        <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.Dialog_DismissButtonText}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <husk:Divider
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            Orientation="Vertical" />
        <Panel
            Grid.Row="0"
            Grid.Column="2"
            ClipToBounds="True">
            <Image
                Height="{Binding #ContentPanel.Bounds.Height}"
                IsVisible="{Binding Background, Converter={x:Static ObjectConverters.IsNotNull}}"
                Opacity="0.2"
                RenderTransform="scale(1.1)"
                Source="{Binding Background}"
                Stretch="Fill">
                <Image.Effect>
                    <BlurEffect Radius="32" />
                </Image.Effect>
            </Image>
            <Panel x:Name="ContentPanel">
                <StackPanel
                    Margin="12"
                    Spacing="12">
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12">
                        <Button
                            Grid.Column="0"
                            Command="{Binding $parent[husk:Frame].GoBackCommand}"
                            Theme="{StaticResource OutlineButtonTheme}">
                            <fi:SymbolIcon
                                FontSize="{StaticResource MediumFontSize}"
                                Symbol="ArrowLeft" />
                        </Button>
                        <TextBlock
                            Grid.Column="1"
                            FontSize="{StaticResource ExtraLargeFontSize}"
                            Text="{Binding Title, FallbackValue=Title}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_SearchBarPlaceholder}}"
                            Text="{Binding QueryText}">
                            <TextBox.InnerRightContent>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        IsVisible="{Binding $parent[TextBox].Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Command="{Binding $parent[TextBox].Clear}"
                                        Content="{fie:SymbolIcon Symbol=Dismiss,
                                                                 FontSize={StaticResource MediumFontSize}}"
                                        Foreground="{StaticResource ControlSecondaryForegroundBrush}" />
                                    <husk:Divider Orientation="Vertical" />
                                    <CheckBox
                                        Margin="6,0"
                                        IsVisible="{Binding IsFilterVisible}"
                                        IsChecked="{Binding IsFilterEnabled, Mode=TwoWay}">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <husk:Tag
                                                Content="{app:LocalizedKey {Binding FilterLoaderLabel}, FallbackValue=Type}"
                                                FontSize="{StaticResource MediumFontSize}" />
                                            <husk:Tag
                                                Content="{Binding FilterVersionLabel, FallbackValue=Version}"
                                                FontSize="{StaticResource MediumFontSize}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </TextBox.InnerRightContent>
                        </TextBox>
                        <Button
                            Grid.Column="1"
                            Classes="Primary"
                            IsEnabled="{Binding Exhibits?.IsFetching, Converter={x:Static BoolConverters.Not}, FallbackValue={x:False}}"
                            Command="{Binding SearchCommand}"
                            IsDefault="True"
                            Theme="{StaticResource OutlineButtonTheme}">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">
                                <husk:SwitchContainer
                                    Width="{StaticResource MediumFontSize}"
                                    Height="{StaticResource MediumFontSize}"
                                    VerticalAlignment="Center"
                                    TargetType="x:Boolean"
                                    Value="{Binding Exhibits?.IsFetching, Mode=OneWay, FallbackValue=True}">
                                    <husk:SwitchCase Value="True">
                                        <husk:ProgressRing
                                            IsIndeterminate="{Binding Exhibits?.IsFetching, Mode=OneWay, FallbackValue=True}"
                                            StrokeWidth="2"
                                            Theme="{StaticResource SolidProgressRingTheme}"
                                            TrackStrokeWidth="2" />
                                    </husk:SwitchCase>
                                    <husk:SwitchCase Value="False">
                                        <fi:SymbolIcon
                                            FontSize="{StaticResource MediumFontSize}"
                                            Symbol="Search" />
                                    </husk:SwitchCase>
                                </husk:SwitchContainer>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Translate {x:Static app:LanguageManager+Keys.ExplorerPage_SearchButtonText}}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <husk:SkeletonContainer
                            Grid.Column="1"
                            MinWidth="128"
                            MinHeight="33"
                            CornerRadius="{StaticResource SmallCornerRadius}"
                            IsLoading="{Binding SelectedRepository.Kinds, Converter={x:Static ObjectConverters.IsNull}}">
                            <TabStrip
                                ItemsSource="{Binding SelectedRepository.Kinds, Mode=OneWay}"
                                SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                                Theme="{StaticResource SegmentedTabStripTheme}">
                                <TabStrip.ItemTemplate>
                                    <DataTemplate x:DataType="resources:ResourceKind">
                                        <TextBlock Text="{app:LocalizedEnum {Binding}}" />
                                    </DataTemplate>
                                </TabStrip.ItemTemplate>
                            </TabStrip>
                        </husk:SkeletonContainer>
                    </Grid>
                </StackPanel>
                <TabStrip
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    ItemsSource="{Binding Repositories}"
                    SelectedItem="{Binding SelectedRepository}"
                    Theme="{StaticResource PivotTabStripTheme}">
                    <TabStrip.Styles>
                        <Style Selector="TabStripItem">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </TabStrip.Styles>
                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="app:RepositoryBasicModel">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </Panel>
        </Panel>
        <husk:Divider
            Grid.Row="1"
            Grid.Column="2" />
        <Panel
            Grid.Row="2"
            Grid.Column="2">
            <StackPanel
                VerticalAlignment="Center"
                Spacing="8">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding
                            Converter="{x:Static BoolConverters.Not}"
                            FallbackValue="{x:True}"
                            Mode="OneWay"
                            Path="Exhibits.IsFetching" />
                        <Binding
                            Converter="{x:Static husk:NumberConverters.IsZero}"
                            FallbackValue="{x:True}"
                            Mode="OneWay"
                            Path="Exhibits.Count" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <fi:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource ExtraLargeFontSize}"
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                    Symbol="Box" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource LargeFontSize}"
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                    Text="{Translate {x:Static app:LanguageManager+Keys.Shared_EmptyListLabelText}}" />
            </StackPanel>
            <husk:InfiniteScrollView
                Padding="12"
                ItemsSource="{Binding Exhibits}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <husk:FlexWrapPanel
                            ColumnSpacing="8"
                            RowSpacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <husk:InfiniteScrollView.PendingContent>
                    <StackPanel
                        Margin="36"
                        Spacing="6">
                        <husk:ProgressRing
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            IsIndeterminate="{Binding Exhibits.IsFetching, Mode=OneWay, FallbackValue=False}"
                            ShowProgressText="False" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="{Translate {x:Static app:LanguageManager+Keys.Shared_FetchingLabelText}}" />
                    </StackPanel>
                </husk:InfiniteScrollView.PendingContent>
                <husk:InfiniteScrollView.ItemTemplate>
                    <DataTemplate x:DataType="app:ExhibitModel">
                        <app:ExhibitPackageButton
                            Command="{Binding $parent[app:ExplorerPage].((app:ExplorerPageModel)DataContext).ViewPackageCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding}"
                            ContextFlyout="{StaticResource ExhibitPackageButtonFlyout}" />
                    </DataTemplate>
                </husk:InfiniteScrollView.ItemTemplate>
                <husk:InfiniteScrollView.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter">
                        <Setter Property="MaxWidth" Value="128" />
                        <Setter Property="MinWidth" Value="90" />
                        <Setter Property="MaxHeight" Value="168" />
                        <Setter Property="MinHeight" Value="128" />
                    </ControlTheme>
                </husk:InfiniteScrollView.ItemContainerTheme>
            </husk:InfiniteScrollView>
        </Panel>
    </Grid>
</app:ScopedPage>
