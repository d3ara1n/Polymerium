<app:Subpage
    x:Class="Polymerium.Avalonia.Pages.InstanceSetupPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:async="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:conv="clr-namespace:Polymerium.Avalonia.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:fie="clr-namespace:FluentIcons.Avalonia.Markup;assembly=FluentIcons.Avalonia"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:TridentCore.Abstractions.Repositories.Resources;assembly=TridentCore.Abstractions"
    Padding="0"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:DataType="app:InstanceSetupPageModel"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    mc:Ignorable="d">
    <app:Subpage.Resources>
        <MenuFlyout
            x:Key="InstancePackageButtonFlyout"
            x:DataType="app:InstancePackageModel">
            <MenuItem
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ActiveMenuText}}"
                Icon="{fie:SymbolIcon Symbol=Star,
                                      FontSize={StaticResource MediumFontSize}}"
                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                ToggleType="CheckBox" />
            <MenuItem Header="-" />
            <MenuItem
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding Info.ProjectName, FallbackValue=Project Name}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ProjectNameMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding Info.ProjectName, FallbackValue=Project Name}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding Info.ProjectId, FallbackValue=Pid}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ProjectIdMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding Info.ProjectId, FallbackValue=Pid}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                IsVisible="{Binding Info.Version, Converter={x:Static husk:ObjectConverters.Is}, ConverterParameter={x:Type app:InstancePackageVersionModel}, FallbackValue={x:False}}"
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding Info.((app:InstancePackageVersionModel)Version).Name, FallbackValue=Version Name}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_VersionNameMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding Info.((app:InstancePackageVersionModel)Version).Name, FallbackValue=Version Name}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem
                IsVisible="{Binding Info.Version, Converter={x:Static husk:ObjectConverters.Is}, ConverterParameter={x:Type app:InstancePackageVersionModel}, FallbackValue={x:False}}"
                Command="{x:Static app:InternalCommands.CopyToClipboardCommand}"
                CommandParameter="{Binding Info.((app:InstancePackageVersionModel)Version).Id, FallbackValue=Vid}"
                Icon="{fie:SymbolIcon Symbol=Copy,
                                      FontSize={StaticResource MediumFontSize}}">
                <MenuItem.Header>
                    <StackPanel>
                        <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_VersionIdMenuText}}" />
                        <TextBlock
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Binding Info.((app:InstancePackageVersionModel)Version).Id, FallbackValue=Vid}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="-" />
            <MenuItem
                Command="{x:Static app:InternalCommands.OpenUriCommand}"
                CommandParameter="{Binding Info.Reference, FallbackValue={x:Null}}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_OpenWebsiteMenuText}}"
                Icon="{fie:SymbolIcon Symbol=Open,
                                      FontSize={StaticResource MediumFontSize}}" />
            <!--  <MenuItem Header="Add to Favorites"  -->
            <!--  Icon="{fie:SymbolIcon Symbol=CollectionsAdd,FontSize={StaticResource MediumFontSize}}" />  -->
            <!--  <MenuItem Header="Remove from Favorite"  -->
            <!--  Icon="{fie:SymbolIcon Symbol=Collections,FontSize={StaticResource MediumFontSize}}" />  -->
            <MenuItem Header="-" />
            <MenuItem
                IsEnabled="{Binding CanRemove}"
                Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).RemovePackageCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding}"
                Foreground="{StaticResource ControlDangerForegroundBrush}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_RemoveMenuText}}"
                Icon="{fie:SymbolIcon Symbol=Delete,
                                      FontSize={StaticResource MediumFontSize}}" />
        </MenuFlyout>
        <MenuFlyout
            x:Key="GroupHeaderContextFlyout"
            x:DataType="app:PackageListItemBase+Header">
            <MenuItem
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_GroupExpandedMenuText}}"
                Icon="{fie:SymbolIcon Symbol=ChevronUpDown,
                                      FontSize={StaticResource MediumFontSize}}"
                IsChecked="{Binding Group.IsExpanded, Mode=TwoWay}"
                ToggleType="CheckBox" />
            <MenuItem Header="-" />
            <MenuItem
                Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).ViewGroupDetailsCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding Group}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ViewGroupDetailsMenuText}}"
                Icon="{fie:SymbolIcon Symbol=Info,
                                      FontSize={StaticResource MediumFontSize}}" />
            <MenuItem Header="-" />
            <MenuItem
                Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).EnableGroupCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding Group}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_EnableGroupMenuText}}"
                Icon="{fie:SymbolIcon Symbol=CheckmarkCircle,
                                      FontSize={StaticResource MediumFontSize}}" />
            <MenuItem
                Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).DisableGroupCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding Group}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_DisableGroupMenuText}}"
                Icon="{fie:SymbolIcon Symbol=DismissCircle,
                                      FontSize={StaticResource MediumFontSize}}" />
            <MenuItem Header="-" />
            <MenuItem
                Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).LowerGroupPriorityCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding Group}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_LowerGroupPriorityMenuText}}"
                Icon="{fie:SymbolIcon Symbol=ArrowUp,
                                      FontSize={StaticResource MediumFontSize}}" />
            <MenuItem
                Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).RaiseGroupPriorityCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding Group}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_RaiseGroupPriorityMenuText}}"
                Icon="{fie:SymbolIcon Symbol=ArrowDown,
                                      FontSize={StaticResource MediumFontSize}}" />
            <MenuItem Header="-" />
            <MenuItem
                Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).DisbandGroupCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding Group}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_DisbandGroupMenuText}}"
                Icon="{fie:SymbolIcon Symbol=GroupDismiss,
                                      FontSize={StaticResource MediumFontSize}}" />
            <MenuItem
                Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).RemoveGroupCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding Group}"
                Foreground="{StaticResource ControlDangerForegroundBrush}"
                Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_RemoveGroupMenuText}}"
                Icon="{fie:SymbolIcon Symbol=Delete,
                                      FontSize={StaticResource MediumFontSize}}" />
        </MenuFlyout>
        <app:PackageListItemTemplateSelector x:Key="PackageListItemTemplate">
            <app:PackageListItemTemplateSelector.HeaderTemplate>
                <DataTemplate x:DataType="app:PackageListItemBase+Header">
                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="4">
                        <Button
                            Grid.Column="0"
                            Padding="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).ToggleGroupExpandedCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding Group}"
                            CornerRadius="{StaticResource SmallCornerRadius}">
                            <husk:SwitchContainer
                                TargetType="x:Boolean"
                                Value="{Binding Group.IsExpanded, Mode=OneWay}">
                                <husk:SwitchCase Value="True">
                                    <fi:SymbolIcon Symbol="ChevronDown" />
                                </husk:SwitchCase>
                                <husk:SwitchCase Value="False">
                                    <fi:SymbolIcon Symbol="ChevronRight" />
                                </husk:SwitchCase>
                            </husk:SwitchContainer>
                        </Button>
                        <Button
                            Grid.Column="1"
                            Padding="4"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).ActivateGroupHeaderCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding Group}"
                            ContextFlyout="{StaticResource GroupHeaderContextFlyout}"
                            CornerRadius="{StaticResource SmallCornerRadius}">
                            <husk:PlaceholderContainer Source="{Binding Group.Info}">
                                <husk:PlaceholderContainer.SourceTemplate>
                                    <DataTemplate DataType="app:GroupInfoModelBase">
                                        <ContentControl
                                            HorizontalAlignment="Stretch"
                                            Content="{Binding}">
                                            <ContentControl.DataTemplates>
                                                <DataTemplate DataType="app:ModpackGroupInfoModel">
                                                    <Grid
                                                        ColumnDefinitions="Auto,*,Auto,Auto"
                                                        ColumnSpacing="8">
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="32"
                                                            Height="32"
                                                            CornerRadius="{StaticResource SmallCornerRadius}">
                                                            <Border.Background>
                                                                <ImageBrush
                                                                    async:ImageBrushLoader.Source="{Binding Thumbnail}"
                                                                    Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource MediumFontSize}"
                                                            FontWeight="{StaticResource ControlStrongFontWeight}"
                                                            Text="{Binding Name, FallbackValue=Modpack}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <husk:IconLabel
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource SmallFontSize}"
                                                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                            Icon="Box"
                                                            Text="{Binding $parent[Button].((app:PackageListItemBase)DataContext).Group.Count, FallbackValue=0}" />
                                                        <husk:Tag
                                                            Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="{StaticResource SmallCornerRadius}">
                                                            <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ModpackGroupTagText}}" />
                                                        </husk:Tag>
                                                    </Grid>
                                                </DataTemplate>
                                                <DataTemplate DataType="app:RecipeGroupInfoModel">
                                                    <Grid
                                                        ColumnDefinitions="Auto,*,Auto,Auto"
                                                        ColumnSpacing="8">
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="32"
                                                            Height="32"
                                                            Background="{StaticResource ControlTranslucentHalfBackgroundBrush}"
                                                            CornerRadius="{StaticResource SmallCornerRadius}">
                                                            <fi:SymbolIcon
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="{StaticResource LargeFontSize}"
                                                                Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                                Symbol="ListBar" />
                                                        </Border>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource MediumFontSize}"
                                                            FontWeight="{StaticResource ControlStrongFontWeight}"
                                                            Text="{Binding Name, FallbackValue=Recipe}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <husk:IconLabel
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource SmallFontSize}"
                                                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                            Icon="Box"
                                                            Text="{Binding $parent[Button].((app:PackageListItemBase)DataContext).Group.Count, FallbackValue=0}" />
                                                        <husk:Tag
                                                            Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="{StaticResource SmallCornerRadius}">
                                                            <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_RecipeGroupTagText}}" />
                                                        </husk:Tag>
                                                    </Grid>
                                                </DataTemplate>
                                            </ContentControl.DataTemplates>
                                        </ContentControl>
                                    </DataTemplate>
                                </husk:PlaceholderContainer.SourceTemplate>
                                <husk:PlaceholderContainer.Placeholder>
                                    <husk:SkeletonContainer
                                        CornerRadius="{StaticResource SmallCornerRadius}"
                                        IsLoading="{Binding !Group.IsLoaded}">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Translate {x:Static app:LanguageManager+Keys.InstancePackageButton_LoadFailedTitleText}}" />
                                            <fi:SymbolIcon Symbol="ArrowCounterclockwise" />
                                        </StackPanel>
                                    </husk:SkeletonContainer>
                                </husk:PlaceholderContainer.Placeholder>
                            </husk:PlaceholderContainer>
                        </Button>
                    </Grid>
                </DataTemplate>
            </app:PackageListItemTemplateSelector.HeaderTemplate>
            <app:PackageListItemTemplateSelector.EntryTemplate>
                <DataTemplate x:DataType="app:PackageListItemBase+Entry">
                    <Grid ColumnDefinitions="Auto,*">
                        <Panel
                            Grid.Column="0"
                            Width="24"
                            IsVisible="{Binding Group.RequireGuideLine}">
                            <Border
                                Width="2"
                                HorizontalAlignment="Center"
                                Background="{StaticResource ControlSecondaryForegroundBrush}" />
                        </Panel>
                        <app:InstancePackageButton
                            Grid.Column="1"
                            Margin="0,3"
                            Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).ViewPackageCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding}"
                            ContextFlyout="{StaticResource InstancePackageButtonFlyout}"
                            DataContext="{Binding Package}"
                            EditCommand="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).EditRawCommand, FallbackValue={x:Null}}"
                            RefreshCommand="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).RefreshPackagesCommand, FallbackValue={x:Null}}"
                            RemoveCommand="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).RemovePackageCommand, FallbackValue={x:Null}}"
                            Theme="{StaticResource ListPackageEntryButtonTheme}">
                            <app:InstancePackageButton.IsEnabled>
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                    <Binding Path="IsLoaded" />
                                    <Binding
                                        Converter="{x:Static ObjectConverters.IsNotNull}"
                                        Path="Info" />
                                </MultiBinding>
                            </app:InstancePackageButton.IsEnabled>
                        </app:InstancePackageButton>
                    </Grid>
                </DataTemplate>
            </app:PackageListItemTemplateSelector.EntryTemplate>
        </app:PackageListItemTemplateSelector>
    </app:Subpage.Resources>
    <husk:BusyContainer>
        <husk:BusyContainer.IsBusy>
            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                <Binding
                    Converter="{x:Static husk:ObjectConverters.Match}"
                    ConverterParameter="Updating"
                    Path="State" />
                <Binding
                    Converter="{x:Static husk:ObjectConverters.Match}"
                    ConverterParameter="Deploying"
                    Path="State" />
            </MultiBinding>
        </husk:BusyContainer.IsBusy>
        <husk:BusyContainer.PendingContent>
            <husk:Card
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource OverlaySolidBackgroundBrush}">
                <StackPanel
                    Margin="24"
                    Spacing="8">
                    <husk:ProgressRing
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Value="{Binding UpdatingProgress, Converter={x:Static conv:InternalConverters.RatioToPercent}, Mode=OneWay}">
                        <husk:ProgressRing.IsIndeterminate>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="UpdatingPending" />
                                <Binding
                                    Converter="{x:Static husk:ObjectConverters.Match}"
                                    ConverterParameter="Deploying"
                                    Path="State" />
                            </MultiBinding>
                        </husk:ProgressRing.IsIndeterminate>
                        <husk:ProgressRing.Transitions>
                            <Transitions>
                                <DoubleTransition
                                    Easing="SineEaseOut"
                                    Property="Value"
                                    Duration="{StaticResource ControlNormalAnimationDuration}" />
                            </Transitions>
                        </husk:ProgressRing.Transitions>
                    </husk:ProgressRing>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="{StaticResource ControlStrongFontWeight}"
                        Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_InoperableLabelText}}" />
                </StackPanel>
            </husk:Card>
        </husk:BusyContainer.PendingContent>
        <Grid RowDefinitions="Auto,0,*">
            <Grid
                Grid.Row="0"
                Margin="{StaticResource PageHeaderlessContentMargin}"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12">
                <Grid
                    Grid.Column="0"
                    RowDefinitions="*,4,Auto">
                    <TextBlock
                        Grid.Row="0"
                        FontSize="{StaticResource ExtraLargeFontSize}"
                        MaxLines="2"
                        Text="{Binding Basic.Name, FallbackValue=Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Border
                            Background="{StaticResource ControlAccentTranslucentFullBackgroundBrush}"
                            BorderBrush="{StaticResource ControlAccentBackgroundBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{StaticResource SmallCornerRadius}">
                            <StackPanel Margin="12,6">
                                <TextBlock
                                    Foreground="{StaticResource ControlAccentForegroundBrush}"
                                    Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_VersionLabelText}}" />
                                <TextBlock
                                    FontSize="{StaticResource LargeFontSize}"
                                    Text="{Binding Basic.Version, FallbackValue=Version}" />

                            </StackPanel>
                        </Border>
                        <Border
                            Background="{StaticResource ControlTranslucentFullBackgroundBrush}"
                            BorderBrush="{StaticResource ControlBackgroundBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{StaticResource SmallCornerRadius}">
                            <DockPanel>
                                <Button
                                    DockPanel.Dock="Right"
                                    Padding="8,4"
                                    IsVisible="{Binding Basic.Source, Converter={x:Static ObjectConverters.IsNull}}"
                                    Background="{StaticResource ControlTranslucentFullBackgroundBrush}"
                                    Command="{Binding EditLoaderCommand}"
                                    CornerRadius="{Binding Source={StaticResource SmallCornerRadius}, Converter={x:Static husk:CornerRadiusConverters.Right}}">
                                    <fi:SymbolIcon
                                        FontSize="{StaticResource LargeFontSize}"
                                        Symbol="TextBulletListSquareEdit" />
                                </Button>
                                <StackPanel Margin="12,6">
                                    <TextBlock
                                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                        Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_LoaderLabelText}}" />
                                    <TextBlock
                                        FontSize="{StaticResource LargeFontSize}"
                                        Text="{app:LocalizedKey {Binding LoaderLabel}, FallbackValue=None}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <husk:LazyContainer
                    Grid.Column="1"
                    MinWidth="198"
                    IsVisible="{Binding Basic.Source, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=True}"
                    Source="{Binding Reference, FallbackValue={x:Null}}">
                    <husk:LazyContainer.FaultContent>
                        <husk:Card
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="2">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ReferenceUnavailableLabelText}}" />
                                <Button
                                    IsVisible="False"
                                    Content="Retry" />
                            </StackPanel>
                        </husk:Card>
                    </husk:LazyContainer.FaultContent>
                    <husk:LazyContainer.SourceTemplate>
                        <DataTemplate x:DataType="app:InstanceReferenceModel">
                            <Border
                                MaxWidth="320"
                                Background="{StaticResource ControlTranslucentFullBackgroundBrush}"
                                CornerRadius="{StaticResource MediumCornerRadius}">
                                <app:Plaque>
                                    <app:Plaque.Header>
                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="4">
                                            <fi:SymbolIcon
                                                Grid.Column="0"
                                                Margin="6,0,0,0"
                                                FontSize="{StaticResource SmallFontSize}"
                                                Symbol="Info" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{Binding VersionName, FallbackValue=Version}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding VersionName}" />
                                            <Button
                                                Grid.Column="2"
                                                Classes="Small"
                                                Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).CheckUpdateCommand, FallbackValue={x:Null}}"
                                                Content="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_SwitchVersionButtonText}}"
                                                Theme="{StaticResource OutlineButtonTheme}" />
                                        </Grid>
                                    </app:Plaque.Header>
                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="8">
                                        <Border
                                            Grid.Column="0"
                                            Width="42"
                                            Height="42"
                                            CornerRadius="{StaticResource SmallCornerRadius}">
                                            <Border.Background>
                                                <ImageBrush
                                                    async:ImageBrushLoader.Source="{Binding Thumbnail, FallbackValue={x:Null}}"
                                                    Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                FontSize="{StaticResource LargeFontSize}"
                                                FontWeight="{StaticResource ControlStrongFontWeight}"
                                                Text="{Binding ProjectName, FallbackValue=Display}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding ProjectName, FallbackValue=Name}" />
                                            <HyperlinkButton NavigateUri="{Binding SourceUrl}">
                                                <ToolTip.Tip>
                                                    <StackPanel Spacing="2">
                                                        <Grid
                                                            ColumnDefinitions="*,Auto"
                                                            ColumnSpacing="4">
                                                            <TextBlock
                                                                Grid.Column="0"
                                                                FontSize="{StaticResource SmallFontSize}"
                                                                Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                                Text="{Translate {x:Static app:LanguageManager+Keys.Shared_ExternalLinkLabelText}}" />
                                                            <fi:SymbolIcon
                                                                Grid.Column="1"
                                                                FontSize="{StaticResource SmallFontSize}"
                                                                Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                                Symbol="Open" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding $parent[HyperlinkButton].NavigateUri}" />
                                                    </StackPanel>
                                                </ToolTip.Tip>
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <TextBlock Text="{Binding Label, FallbackValue=LABEL, Converter={x:Static husk:StringConverters.ToUpper}}" />
                                                    <fi:SymbolIcon
                                                        FontSize="{StaticResource MediumFontSize}"
                                                        Symbol="Open" />
                                                </StackPanel>
                                            </HyperlinkButton>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Padding="8"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[app:InstanceSetupPage].((app:InstanceSetupPageModel)DataContext).ViewDetailsCommand, FallbackValue={x:Null}}"
                                            CornerRadius="{StaticResource FullCornerRadius}">
                                            <fi:SymbolIcon
                                                FontSize="{StaticResource LargeFontSize}"
                                                Symbol="ArrowRight" />
                                        </Button>
                                    </Grid>
                                </app:Plaque>
                            </Border>
                        </DataTemplate>
                    </husk:LazyContainer.SourceTemplate>
                </husk:LazyContainer>
            </Grid>
            <Grid
                Grid.Row="2"
                RowDefinitions="Auto,*">
                <Grid
                    Grid.Row="0"
                    Margin="16,8"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12">

                    <!--  搜索栏  -->
                    <TextBox
                        Grid.Column="0"
                        MinWidth="168"
                        PlaceholderText="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_FilterBarPlaceholder}}"
                        Text="{Binding FilterText, Mode=OneWayToSource}"
                        ToolTip.Tip="@Author #Summary !Id Names">
                        <TextBox.InnerRightContent>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    IsVisible="{Binding $parent[TextBox].Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Command="{Binding $parent[TextBox].Clear}"
                                    Content="{fie:SymbolIcon Symbol=Dismiss,
                                                             FontSize={StaticResource MediumFontSize}}"
                                    Foreground="{StaticResource ControlSecondaryForegroundBrush}" />
                                <Button Classes.Primary="{Binding IsFilterActive, Mode=OneWay}">
                                    <Button.Flyout>
                                        <Flyout>
                                            <Grid
                                                MinWidth="320"
                                                MaxWidth="520"
                                                MaxHeight="360"
                                                Margin="12"
                                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
                                                RowSpacing="8">
                                                <TextBlock
                                                    Grid.Row="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource SmallFontSize}"
                                                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                    Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_FilterLabelText}}" />
                                                <Grid
                                                    Grid.Row="1"
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="24">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Bottom"
                                                        Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_StatusFilterText}}" />
                                                    <TabStrip
                                                        Grid.Column="1"
                                                        SelectedItem="{Binding FilterEnability, Mode=TwoWay}"
                                                        Theme="{StaticResource SegmentedTabStripTheme}">
                                                        <TabStrip.ItemTemplate>
                                                            <DataTemplate DataType="app:FilterModel">
                                                                <TextBlock Text="{app:LocalizedKey {Binding Label}}" />
                                                            </DataTemplate>
                                                        </TabStrip.ItemTemplate>
                                                        <app:FilterModel
                                                            Label="Enum_All"
                                                            Value="{x:Null}" />
                                                        <app:FilterModel
                                                            Label="Enum_Enabled"
                                                            Value="{x:True}" />
                                                        <app:FilterModel
                                                            Label="Enum_Disabled"
                                                            Value="{x:False}" />
                                                    </TabStrip>
                                                </Grid>
                                                <husk:Divider Grid.Row="2" />
                                                <Grid
                                                    Grid.Row="3"
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="24">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Bottom"
                                                        Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_SourceFilterText}}" />
                                                    <TabStrip
                                                        Grid.Column="1"
                                                        SelectedItem="{Binding FilterLockility, Mode=TwoWay}"
                                                        Theme="{StaticResource SegmentedTabStripTheme}">
                                                        <TabStrip.ItemTemplate>
                                                            <DataTemplate DataType="app:FilterModel">
                                                                <TextBlock Text="{app:LocalizedKey {Binding Label}}" />
                                                            </DataTemplate>
                                                        </TabStrip.ItemTemplate>
                                                        <app:FilterModel
                                                            Label="Enum_All"
                                                            Value="{x:Null}" />
                                                        <app:FilterModel
                                                            Label="InstanceSetupPage_SourceImportText"
                                                            Value="{x:True}" />
                                                        <app:FilterModel
                                                            Label="InstanceSetupPage_SourceLocalText"
                                                            Value="{x:False}" />
                                                    </TabStrip>
                                                </Grid>
                                                <husk:Divider Grid.Row="4" />
                                                <Grid
                                                    Grid.Row="5"
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="24">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Bottom"
                                                        Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_TypeFilterText}}" />
                                                    <TabStrip
                                                        Grid.Column=" 1"
                                                        SelectedItem="{Binding FilterKind, Mode=TwoWay}"
                                                        Theme="{StaticResource SegmentedTabStripTheme}">
                                                        <TabStrip.ItemTemplate>
                                                            <DataTemplate DataType="app:FilterModel">
                                                                <TextBlock Text="{app:LocalizedKey {Binding Label}}" />
                                                            </DataTemplate>
                                                        </TabStrip.ItemTemplate>
                                                        <app:FilterModel
                                                            Label="Enum_All"
                                                            Value="{x:Null}" />
                                                        <app:FilterModel
                                                            Label="ResourceKind_Mod"
                                                            Value="{x:Static resources:ResourceKind.Mod}" />
                                                        <app:FilterModel
                                                            Label="ResourceKind_ResourcePack"
                                                            Value="{x:Static resources:ResourceKind.ResourcePack}" />
                                                        <app:FilterModel
                                                            Label="ResourceKind_ShaderPack"
                                                            Value="{x:Static resources:ResourceKind.ShaderPack}" />
                                                        <app:FilterModel
                                                            Label="ResourceKind_DataPack"
                                                            Value="{x:Static resources:ResourceKind.DataPack}" />
                                                    </TabStrip>
                                                </Grid>
                                                <husk:Divider Grid.Row="6" />
                                                <Grid
                                                    Grid.Row="7"
                                                    ColumnDefinitions="*,Auto,Auto"
                                                    ColumnSpacing="4">
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource SmallFontSize}"
                                                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                        Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_TagFilterText}}" />
                                                </Grid>
                                                <Panel
                                                    Grid.Row="8"
                                                    MinHeight="120">
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding TagsView.Count, Converter={x:Static husk:NumberConverters.IsZero}, FallbackValue=True}"
                                                        Spacing="8">
                                                        <fi:SymbolIcon
                                                            HorizontalAlignment="Center"
                                                            FontSize="{StaticResource ExtraLargeFontSize}"
                                                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                            Symbol="TagMultiple" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontSize="{StaticResource LargeFontSize}"
                                                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                                            Text="{Translate {x:Static app:LanguageManager+Keys.Shared_EmptyListLabelText}}" />
                                                    </StackPanel>
                                                    <ScrollViewer>
                                                        <ItemsControl ItemsSource="{Binding TagsView}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel
                                                                        ItemSpacing="8"
                                                                        LineSpacing="8" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="app:InstancePackageFilterTagModel">
                                                                    <Border
                                                                        Padding="8"
                                                                        BorderBrush="{StaticResource ControlBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{StaticResource SmallCornerRadius}">
                                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                            <StackPanel
                                                                                Orientation="Horizontal"
                                                                                Spacing="4">
                                                                                <TextBlock Text="{Binding Content}" />
                                                                                <TextBlock Foreground="{StaticResource ControlSecondaryForegroundBrush}">
                                                                                    <Run Text="(" />
                                                                                    <Run Text="{Binding RefCount, Mode=OneWay}" />
                                                                                    <Run Text=")" />
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </CheckBox>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Panel>
                                            </Grid>
                                        </Flyout>
                                    </Button.Flyout>
                                    <fi:SymbolIcon
                                        FontSize="{StaticResource MediumFontSize}"
                                        Symbol="Filter" />
                                </Button>
                            </StackPanel>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    <TextBlock Grid.Column="1">
                        <Run
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ResultCountLabelText}}" />
                        <LineBreak />
                        <Run Text="{Binding FilteredCount, Mode=OneWay, FallbackValue=0}" />
                        <Run
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="/" />
                        <Run Text="{Binding StageCount, Mode=OneWay, FallbackValue=0}" />
                    </TextBlock>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <StackPanel IsVisible="{Binding IsRefreshing}">
                            <husk:ProgressRing
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                IsIndeterminate="{Binding IsRefreshing}" />
                            <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_RefreshingLabelText}}" />
                        </StackPanel>
                        <Border
                            Background="{StaticResource ControlTranslucentHalfBackgroundBrush}"
                            CornerRadius="{StaticResource SmallCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="8,0"
                                    VerticalAlignment="Center">
                                    <Run
                                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                        Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_RuleCountLabelText}}" />
                                    <Run
                                        FontWeight="{StaticResource ControlStrongFontWeight}"
                                        Text="{Binding Rules.Count, Mode=OneWay, FallbackValue=0}" />
                                </TextBlock>
                                <Button
                                    Classes="Small"
                                    Width="{Binding $self.Bounds.Height}"
                                    Margin="3"
                                    Padding="0"
                                    IsEnabled="{Binding !IsRefreshing}"
                                    Command="{Binding EditRulesCommand}">
                                    <fi:SymbolIcon
                                        FontSize="{StaticResource SmallFontSize}"
                                        Symbol="TaskListSquareSettings" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <SplitButton
                            Classes="Primary"
                            Command="{Binding GotoExplorerPageCommand}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Command="{Binding UpdateBatchCommand}"
                                        Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_BatchUpdateMenuText}}"
                                        Icon="{fie:SymbolIcon Symbol=ArrowTurnRightUp,
                                                              FontSize={StaticResource MediumFontSize}}" />
                                    <MenuItem
                                        Command="{Binding GotoDependencyGraphCommand}"
                                        Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_DependencyGraphMenuText}}"
                                        Icon="{fie:SymbolIcon Symbol=ArrowSplit,
                                                              FontSize={StaticResource MediumFontSize}}" />
                                    <MenuItem
                                        Command="{Binding ImportFromRecipeCommand}"
                                        Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ImportRecipeMenuText}}"
                                        Icon="{fie:SymbolIcon Symbol=ListBar,
                                                              FontSize={StaticResource MediumFontSize}}" />
                                    <MenuItem
                                        Command="{Binding ImportListCommand}"
                                        Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ImportListMenuText}}"
                                        Icon="{fie:SymbolIcon Symbol=ArrowImport,
                                                              FontSize={StaticResource MediumFontSize}}" />
                                    <MenuItem
                                        Command="{Binding ExportListCommand}"
                                        Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_ExportListMenuText}}"
                                        Icon="{fie:SymbolIcon Symbol=ArrowExport,
                                                              FontSize={StaticResource MediumFontSize}}" />
                                    <MenuItem Header="-" />
                                    <MenuItem
                                        Command="{Binding BatchEnableCommand}"
                                        Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_BatchEnableMenuText}}"
                                        Icon="{fie:SymbolIcon Symbol=CheckmarkCircle,
                                                              FontSize={StaticResource MediumFontSize}}" />
                                    <MenuItem
                                        Command="{Binding BatchDisableCommand}"
                                        Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_BatchDisableMenuText}}"
                                        Icon="{fie:SymbolIcon Symbol=DismissCircle,
                                                              FontSize={StaticResource MediumFontSize}}" />
                                    <MenuItem
                                        Command="{Binding BatchDeleteCommand}"
                                        Foreground="{StaticResource ControlDangerForegroundBrush}"
                                        Header="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_BatchDeleteMenuText}}"
                                        Icon="{fie:SymbolIcon Symbol=Delete,
                                                              FontSize={StaticResource MediumFontSize}}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <fi:SymbolIcon
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource MediumFontSize}"
                                    Symbol="Wand" />
                                <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.InstanceSetupPage_GetMoreButtonText}}" />
                            </StackPanel>
                        </SplitButton>
                    </StackPanel>
                </Grid>
                <Panel
                    Grid.Row="1"
                    Grid.Column="0">
                    <StackPanel
                        VerticalAlignment="Center"
                        IsVisible="{Binding FlatView.Count, Converter={x:Static husk:NumberConverters.IsZero}, FallbackValue=True}"
                        Spacing="8">
                        <fi:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource ExtraLargeFontSize}"
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Symbol="Box" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource LargeFontSize}"
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Text="{Translate {x:Static app:LanguageManager+Keys.Shared_EmptyListLabelText}}" />
                    </StackPanel>
                    <ScrollViewer>
                        <ItemsControl
                            Margin="{StaticResource PageToplessContentMargin}"
                            ItemTemplate="{StaticResource PackageListItemTemplate}"
                            ItemsSource="{Binding FlatView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </Grid>
        </Grid>
    </husk:BusyContainer>
</app:Subpage>
