<husk:Page
    x:Class="Polymerium.Avalonia.Pages.RecipePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:lang="https://github.com/d3ara1n/Polymerium/Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:DataType="app:RecipePageModel"
    mc:Ignorable="d">
    <husk:Page.Header>
        <Grid
            ColumnDefinitions="*,Auto,Auto,Auto"
            ColumnSpacing="8">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis"
                Theme="{StaticResource PageHeaderTextBlockTheme}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding EditCommand}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6">
                    <fi:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="{StaticResource MediumFontSize}"
                        Symbol="Edit" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Static lang:Resources.RecipePage_EditButtonText}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{Binding ExportCommand}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6">
                    <fi:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="{StaticResource MediumFontSize}"
                        Symbol="ArrowExport" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Static lang:Resources.RecipePage_ExportButtonText}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="3"
                Classes="Primary"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6">
                    <fi:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="{StaticResource MediumFontSize}"
                        Symbol="Add" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Static lang:Resources.RecipePage_AddPackageButtonText}" />
                </StackPanel>
            </Button>
        </Grid>
    </husk:Page.Header>
    <StackPanel Spacing="16">
        <Border
            Background="{StaticResource LayerBackgroundBrush}"
            CornerRadius="{StaticResource MediumCornerRadius}"
            Padding="16,12">
            <StackPanel>
                <TextBlock
                    IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Text="{Binding Description}"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                    FontSize="{StaticResource SmallFontSize}"
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                    Text="{x:Static lang:Resources.RecipePage_NoDescriptionText}" />
            </StackPanel>
        </Border>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox
                Grid.Column="0"
                MinWidth="320"
                MaxWidth="480"
                HorizontalAlignment="Left"
                PlaceholderText="{x:Static lang:Resources.RecipePage_SearchPlaceholderText}"
                Text="{Binding QueryText}" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <fi:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="{StaticResource SmallFontSize}"
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Symbol="BoxMultiple" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource SmallFontSize}"
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="{Binding Items.Count}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource SmallFontSize}"
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="{x:Static lang:Resources.RecipesPage_ItemCountSuffix}" />
                    <husk:ProgressRing
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center"
                        IsIndeterminate="{Binding IsRefreshing}"
                        IsVisible="{Binding IsRefreshing}"
                        ShowProgressText="False" />
                </StackPanel>
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{Binding KindFilterOptions}"
                    SelectedItem="{Binding SelectedKind, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static app:LocalizedEnumConverters.LocalizedResourceKind}, TargetNullValue={x:Static lang:Resources.RecipePage_KindFilterAllText}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>
        <app:EmptyContainer
            Icon="BoxMultiple"
            IsEmpty="{Binding Items.Count, Converter={x:Static husk:NumberConverters.IsZero}}"
            Text="{Binding EmptyText}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="app:RecipeItemModel">
                        <app:RecipeItemButton
                            Command="{Binding $parent[ItemsControl].((app:RecipePageModel)DataContext).OpenItemCommand}"
                            CommandParameter="{Binding}"
                            RemoveCommand="{Binding $parent[ItemsControl].((app:RecipePageModel)DataContext).RemoveItemCommand}"
                            Theme="{StaticResource RecipeItemButtonTheme}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </app:EmptyContainer>
    </StackPanel>
</husk:Page>
