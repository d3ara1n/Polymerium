<husk:Page
    x:Class="Polymerium.Avalonia.Pages.RecipePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:fie="clr-namespace:FluentIcons.Avalonia.Markup;assembly=FluentIcons.Avalonia"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:lang="https://github.com/d3ara1n/Polymerium/Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:DataType="app:RecipePageModel"
    mc:Ignorable="d"
    ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <husk:Page.Header>
        <Grid
            ColumnDefinitions="*,Auto,Auto,Auto"
            ColumnSpacing="8">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis"
                Theme="{StaticResource PageHeaderTextBlockTheme}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding EditCommand}">
                <husk:IconLabel
                    Icon="Edit"
                    Text="{x:Static lang:Resources.RecipePage_EditButtonText}" />
            </Button>
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{Binding ExportCommand}">
                <husk:IconLabel
                    Icon="ArrowExport"
                    Text="{x:Static lang:Resources.RecipePage_ExportButtonText}" />
            </Button>
            <Button
                Grid.Column="3"
                Classes="Primary"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}">
                <husk:IconLabel
                    Icon="Add"
                    Text="{x:Static lang:Resources.RecipePage_AddPackageButtonText}" />
            </Button>
        </Grid>
    </husk:Page.Header>
    <Grid
        RowDefinitions="Auto,Auto,*"
        RowSpacing="16">
        <husk:SwitchContainer
            Grid.Row="0"
            TargetType="x:Boolean"
            Value="{Binding Description, Converter={x:Static StringConverters.IsNullOrEmpty}}">
            <husk:SwitchCase Value="{x:False}">
                <TextBlock
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                    Text="{Binding Description}"
                    TextWrapping="Wrap" />
            </husk:SwitchCase>
            <husk:SwitchCase Value="{x:True}">
                <TextBlock
                    FontSize="{StaticResource SmallFontSize}"
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                    Text="{x:Static lang:Resources.RecipePage_NoDescriptionText}" />
            </husk:SwitchCase>
        </husk:SwitchContainer>
        <Grid
            Grid.Row="1"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">
            <TextBox
                Grid.Column="0"
                MinWidth="168"
                PlaceholderText="{x:Static lang:Resources.RecipePage_SearchPlaceholderText}"
                Text="{Binding QueryText}">
                <TextBox.InnerRightContent>
                    <Button
                        Command="{Binding $parent[TextBox].Clear}"
                        Content="{fie:SymbolIcon Symbol=Dismiss,
                                                 FontSize={StaticResource MediumFontSize}}"
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        IsVisible="{Binding $parent[TextBox].Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </TextBox.InnerRightContent>
            </TextBox>
            <TextBlock Grid.Column="1">
                <Run
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                    Text="{x:Static lang:Resources.RecipePage_PackageCountLabelText}" />
                <LineBreak />
                <Run Text="{Binding Items.Count, Mode=OneWay, FallbackValue=0}" />
                <Run
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                    Text="/" />
                <Run Text="{Binding TotalCount, Mode=OneWay, FallbackValue=0}" />
            </TextBlock>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <StackPanel IsVisible="{Binding IsRefreshing}">
                    <husk:ProgressRing
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        IsIndeterminate="{Binding IsRefreshing}" />
                    <TextBlock Text="{x:Static lang:Resources.Shared_FetchingLabelText}" />
                </StackPanel>
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{Binding KindFilterOptions}"
                    SelectedItem="{Binding SelectedKind, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static app:LocalizedEnumConverters.LocalizedResourceKind}, TargetNullValue={x:Static lang:Resources.RecipePage_KindFilterAllText}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>
        <app:EmptyContainer
            Grid.Row="2"
            Icon="BoxMultiple"
            IsEmpty="{Binding Items.Count, Converter={x:Static husk:NumberConverters.IsZero}}"
            Text="{Binding EmptyText}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:RecipeItemModel">
                        <app:RecipeItemButton
                            Margin="0,0,0,8"
                            Command="{Binding $parent[ItemsControl].((app:RecipePageModel)DataContext).OpenItemCommand}"
                            CommandParameter="{Binding}"
                            Theme="{StaticResource RecipeItemButtonTheme}">
                            <app:RecipeItemButton.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Command="{Binding $parent[ItemsControl].((app:RecipePageModel)DataContext).EditItemTagsCommand}"
                                        CommandParameter="{Binding}"
                                        Header="{x:Static lang:Resources.RecipeItemModal_EditTagsButtonText}"
                                        Icon="{fie:SymbolIcon Symbol=Tag,
                                                              FontSize={StaticResource MediumFontSize}}" />
                                    <MenuItem
                                        Command="{Binding $parent[ItemsControl].((app:RecipePageModel)DataContext).EditItemNoteCommand}"
                                        CommandParameter="{Binding}"
                                        Header="{x:Static lang:Resources.RecipePage_EditNoteMenuText}"
                                        Icon="{fie:SymbolIcon Symbol=Edit,
                                                              FontSize={StaticResource MediumFontSize}}" />
                                    <MenuItem Header="-" />
                                    <MenuItem
                                        Command="{Binding $parent[ItemsControl].((app:RecipePageModel)DataContext).RemoveItemCommand}"
                                        CommandParameter="{Binding}">
                                        <MenuItem.Header>
                                            <TextBlock
                                                Foreground="{StaticResource ControlDangerForegroundBrush}"
                                                Text="{x:Static lang:Resources.RecipePage_RemoveItemMenuText}" />
                                        </MenuItem.Header>
                                        <MenuItem.Icon>
                                            <fi:SymbolIcon
                                                FontSize="{StaticResource MediumFontSize}"
                                                Foreground="{StaticResource ControlDangerForegroundBrush}"
                                                Symbol="Delete" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </app:RecipeItemButton.ContextFlyout>
                            </app:RecipeItemButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </app:EmptyContainer>
    </Grid>
</husk:Page>
