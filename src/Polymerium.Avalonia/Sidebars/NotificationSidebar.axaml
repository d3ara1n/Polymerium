<husk:Sidebar
    x:Class="Polymerium.Avalonia.Sidebars.NotificationSidebar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:async="using:AsyncImageLoader"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fi="using:FluentIcons.Avalonia"
    xmlns:fie="using:FluentIcons.Avalonia.Markup"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="380"
    Padding="0"
    d:DesignHeight="600"
    d:DesignWidth="400"
    x:DataType="{x:Type app:NotificationSidebarModel}"
    mc:Ignorable="d">
    <husk:Sidebar.Resources>
        <DataTemplate x:Key="NotificationLevelIconTemplate" x:DataType="app:NotificationModel">
            <husk:SwitchContainer
                AutomationProperties.Name="{app:LocalizedEnum {Binding Level}}"
                TargetType="husk:GrowlLevel"
                ToolTip.Tip="{app:LocalizedEnum {Binding Level}}"
                Value="{Binding Level}">
                <husk:SwitchCase Value="Information">
                    <fi:SymbolIcon
                        FontSize="20"
                        Foreground="{DynamicResource ControlSecondaryForegroundBrush}"
                        Symbol="Info" />
                </husk:SwitchCase>
                <husk:SwitchCase Value="Success">
                    <fi:SymbolIcon
                        FontSize="20"
                        Foreground="{DynamicResource ControlSuccessForegroundBrush}"
                        Symbol="CheckmarkCircle" />
                </husk:SwitchCase>
                <husk:SwitchCase Value="Warning">
                    <fi:SymbolIcon
                        FontSize="20"
                        Foreground="{DynamicResource ControlWarningForegroundBrush}"
                        Symbol="Warning" />
                </husk:SwitchCase>
                <husk:SwitchCase Value="Danger">
                    <fi:SymbolIcon
                        FontSize="20"
                        Foreground="{DynamicResource ControlDangerForegroundBrush}"
                        Symbol="DismissCircle" />
                </husk:SwitchCase>
            </husk:SwitchContainer>
        </DataTemplate>
    </husk:Sidebar.Resources>
    <husk:Sidebar.Styles>
        <Style Selector="Border.NotificationRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.NotificationRow.Unread">
            <Setter Property="Background" Value="{DynamicResource ControlAccentTranslucentHalfBackgroundBrush}" />
        </Style>
        <Style Selector="TextBlock.NotificationMetadata">
            <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlSecondaryForegroundBrush}" />
        </Style>
    </husk:Sidebar.Styles>
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Grid
            Grid.Row="0"
            Margin="{StaticResource SidebarBottomlessContentMargin}"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="12">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="{StaticResource LargeFontSize}"
                FontWeight="{StaticResource ControlStrongFontWeight}"
                Text="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_NotificationsLabelText}}" />
            <Button
                Grid.Column="1"
                Classes="Small"
                IsEnabled="{Binding UnreadNotificationCount, Converter={x:Static husk:NumberConverters.IsNonZero}}"
                Command="{Binding MarkAllAsReadCommand}"
                Theme="{StaticResource OutlineButtonTheme}">
                <husk:IconLabel
                    Icon="Checkmark"
                    Text="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_MarkAllAsReadButtonText}}" />
            </Button>
            <Button
                Grid.Column="2"
                Classes="Small"
                AutomationProperties.Name="{Translate {x:Static app:LanguageManager+Keys.Dialog_DismissButtonText}}"
                Click="DismissButton_OnClick"
                ToolTip.Tip="{Translate {x:Static app:LanguageManager+Keys.Dialog_DismissButtonText}}">
                <fi:SymbolIcon
                    FontSize="{StaticResource MediumFontSize}"
                    Symbol="Dismiss" />
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel
                Margin="{StaticResource SidebarContentMargin}"
                HorizontalAlignment="Center"
                IsVisible="{Binding Notifications.Count, Converter={x:Static husk:NumberConverters.IsZero}}"
                Spacing="8">
                <Border
                    Width="56"
                    Height="56"
                    Background="{StaticResource ControlAccentTranslucentHalfBackgroundBrush}"
                    CornerRadius="28">
                    <fi:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="AlertOff" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource MediumFontSize}"
                    FontWeight="{StaticResource ControlStrongFontWeight}"
                    Text="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_EmptyTitle}}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                    Text="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_EmptyPrompt}}" />
            </StackPanel>
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                IsVisible="{Binding Notifications.Count, Converter={x:Static husk:NumberConverters.IsNonZero}}">
                <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:NotificationModel">
                            <Border
                                Classes="NotificationRow"
                                Classes.Unread="{Binding IsRead, Converter={x:Static BoolConverters.Not}}">
                                <Grid RowDefinitions="2,Auto">
                                    <Grid
                                        Grid.Row="1"
                                        Margin="16,12"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="12"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="8">
                                        <Grid
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="8">
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontWeight="{StaticResource ControlStrongFontWeight}"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <husk:Tag
                                                    Classes="Small Primary"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsRead, Converter={x:Static BoolConverters.Not}}"
                                                    Content="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_UnreadTagText}}" />
                                                <husk:Tag
                                                    Classes="Small"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsCancelled}"
                                                    Content="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_CancelledTagText}}" />
                                                <TextBlock
                                                    Classes="NotificationMetadata"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding PublishedAt}" />
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    Classes="Small"
                                                    Padding="4"
                                                    AutomationProperties.Name="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_MoreActionsButtonText}}"
                                                    Theme="{StaticResource GhostButtonTheme}"
                                                    ToolTip.Tip="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_MoreActionsButtonText}}">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem
                                                                IsVisible="{Binding IsRead, Converter={x:Static BoolConverters.Not}}"
                                                                Command="{Binding $parent[app:NotificationSidebar].((app:NotificationSidebarModel)DataContext).MarkAsReadCommand, FallbackValue={x:Null}}"
                                                                CommandParameter="{Binding}"
                                                                Header="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_MarkAsReadMenuText}}"
                                                                Icon="{fie:SymbolIcon CheckmarkCircle,
                                                                                  FontSize={StaticResource MediumFontSize}}" />
                                                            <MenuItem
                                                                IsVisible="{Binding IsRead}"
                                                                Command="{Binding $parent[app:NotificationSidebar].((app:NotificationSidebarModel)DataContext).MarkAsUnreadCommand, FallbackValue={x:Null}}"
                                                                CommandParameter="{Binding}"
                                                                Header="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_MarkAsUnreadMenuText}}"
                                                                Icon="{fie:SymbolIcon CheckmarkCircleHint,
                                                                                  FontSize={StaticResource MediumFontSize}}" />
                                                            <MenuItem
                                                                Command="{Binding $parent[app:NotificationSidebar].((app:NotificationSidebarModel)DataContext).RemoveNotificationCommand, FallbackValue={x:Null}}"
                                                                CommandParameter="{Binding}"
                                                                Header="{Translate {x:Static app:LanguageManager+Keys.NotificationSidebar_RemoveMenuText}}"
                                                                Icon="{fie:SymbolIcon DismissCircle,
                                                                                  FontSize={StaticResource MediumFontSize}}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                    <fi:SymbolIcon
                                                        FontSize="{StaticResource MediumFontSize}"
                                                        Symbol="MoreHorizontal" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Panel
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="0"
                                            Width="36"
                                            Height="36"
                                            VerticalAlignment="Top">
                                            <husk:SwitchContainer
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                TargetType="x:Boolean"
                                                Value="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <husk:SwitchCase Value="True">
                                                    <Border
                                                        Width="28"
                                                        Height="28"
                                                        ClipToBounds="True"
                                                        CornerRadius="{StaticResource FullCornerRadius}">
                                                        <Image
                                                            async:ImageLoader.Source="{Binding Thumbnail}"
                                                            Stretch="UniformToFill" />
                                                    </Border>
                                                </husk:SwitchCase>
                                                <husk:SwitchCase Value="False">
                                                    <ContentControl
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource NotificationLevelIconTemplate}" />
                                                </husk:SwitchCase>
                                            </husk:SwitchContainer>
                                            <husk:ProgressRing
                                                Width="36"
                                                Height="36"
                                                IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                ShowProgressText="False"
                                                StrokeWidth="3"
                                                TrackStrokeWidth="3"
                                                Value="{Binding Progress}">
                                                <husk:ProgressRing.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="IsProgressBarVisible" />
                                                        <Binding
                                                            Converter="{x:Static BoolConverters.Not}"
                                                            Path="IsCancelled" />
                                                    </MultiBinding>
                                                </husk:ProgressRing.IsVisible>
                                            </husk:ProgressRing>
                                        </Panel>
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Spacing="8">
                                            <TextBlock
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap" />
                                            <ItemsControl
                                                IsEnabled="{Binding IsCancelled, Converter={x:Static BoolConverters.Not}}"
                                                IsVisible="{Binding Actions.Count, Converter={x:Static husk:NumberConverters.IsNonZero}}"
                                                ItemsSource="{Binding Actions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel
                                                            ItemSpacing="8"
                                                            LineSpacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="husk:GrowlAction">
                                                        <Button
                                                            Classes="Small"
                                                            Command="{Binding Command}"
                                                            CommandParameter="{Binding Parameter}"
                                                            Content="{Binding Text}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                    <husk:SwitchContainer
                                        Grid.Row="0"
                                        TargetType="husk:GrowlLevel"
                                        Value="{Binding Level}">
                                        <husk:SwitchCase Value="Information">
                                            <Border Background="{DynamicResource ControlBorderBrush}" />
                                        </husk:SwitchCase>
                                        <husk:SwitchCase Value="Success">
                                            <Border Background="{DynamicResource ControlSuccessBorderBrush}" />
                                        </husk:SwitchCase>
                                        <husk:SwitchCase Value="Warning">
                                            <Border Background="{DynamicResource ControlWarningBorderBrush}" />
                                        </husk:SwitchCase>
                                        <husk:SwitchCase Value="Danger">
                                            <Border Background="{DynamicResource ControlDangerBorderBrush}" />
                                        </husk:SwitchCase>
                                    </husk:SwitchContainer>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</husk:Sidebar>
