        <PackageReference Include="Velopack" Version="1.2.0"/>
        <PackageReference Include="VelopackExtension.MirrorChyan" Version="1.0.8"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Properties\*.resx"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\submodules\Trident.Net\src\TridentCore.Core\TridentCore.Core.csproj"/>
        <ProjectReference Include="..\..\submodules\Trident.Net\src\TridentCore.Text\TridentCore.Text.csproj"/>
    </ItemGroup>
</Project>
