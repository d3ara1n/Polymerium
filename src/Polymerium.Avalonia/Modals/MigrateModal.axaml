<husk:Modal
    x:Class="Polymerium.Avalonia.Modals.MigrateModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:lang="https://github.com/d3ara1n/Polymerium/Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="560"
    Height="540"
    d:DesignHeight="540"
    d:DesignWidth="560"
    x:DataType="app:MigrateModalModel"
    mc:Ignorable="d">
    <DockPanel VerticalSpacing="12">
        <!--  Header  -->
        <DockPanel DockPanel.Dock="Top">
            <Button
                DockPanel.Dock="Right"
                Classes="Small"
                Command="{Binding $parent[app:MigrateModal].Dismiss}"
                CornerRadius="{StaticResource FullCornerRadius}"
                IsCancel="True">
                <fi:SymbolIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource MediumFontSize}"
                    Symbol="Dismiss" />
            </Button>
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <fi:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="{StaticResource LargeFontSize}"
                    Symbol="ArrowImport" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource LargeFontSize}"
                    FontWeight="{StaticResource ControlStrongFontWeight}"
                    Text="{x:Static lang:Resources.MigrateModal_Title}" />
            </StackPanel>
        </DockPanel>

        <husk:PlaceholderContainer Source="{Binding Result}">
            <husk:PlaceholderContainer.SourceTemplate>
                <DataTemplate DataType="app:MigrateScanResult">
                    <DockPanel VerticalSpacing="12">
                        <husk:ModalActionPanel
                            DockPanel.Dock="Bottom"
                            Spacing="8">
                            <Button Command="{Binding $parent[app:MigrateModal].((app:MigrateModalModel)DataContext).BackCommand}">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <fi:SymbolIcon
                                        FontSize="{StaticResource MediumFontSize}"
                                        Symbol="ArrowLeft" />
                                    <TextBlock Text="{x:Static lang:Resources.MigrateModal_BackButtonText}" />
                                </StackPanel>
                            </Button>
                            <Button
                                Classes="Primary"
                                Command="{Binding $parent[app:MigrateModal].((app:MigrateModalModel)DataContext)?.MigrateCommand}"
                                CommandParameter="{Binding $parent[app:MigrateModal]}"
                                Content="{Binding $parent[app:MigrateModal].((app:MigrateModalModel)DataContext)?.MigrateLabel}"
                                IsDefault="True" />
                        </husk:ModalActionPanel>
                        <Grid
                            DockPanel.Dock="Top"
                            Margin="12,0"
                            ColumnDefinitions="Auto,*">
                            <CheckBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Content="{x:Static lang:Resources.MigrateModal_SelectAll}"
                                IsChecked="{Binding $parent[app:MigrateModal].((app:MigrateModalModel)DataContext)?.AllSelected}"
                                IsThreeState="True" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource SmallFontSize}"
                                Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                Text="{Binding $parent[app:MigrateModal].((app:MigrateModalModel)DataContext)?.SelectedSummary}" />
                        </Grid>
                        <husk:Card Padding="12,8">
                            <app:EmptyContainer
                                Icon="FolderSearch"
                                IsEmpty="{Binding Instances.Count, Converter={x:Static husk:NumberConverters.IsZero}, FallbackValue=True}">
                                <ScrollViewer Padding="0">
                                    <ItemsControl ItemsSource="{Binding Instances}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="app:MigrateInstanceModel">
                                                <CheckBox
                                                    Padding="4"
                                                    HorizontalContentAlignment="Stretch"
                                                    IsEnabled="{Binding Instance.CorruptReason, Converter={x:Static ObjectConverters.IsNull}}"
                                                    Cursor="Hand"
                                                    IsChecked="{Binding IsSelected}">
                                                    <Grid
                                                        ColumnDefinitions="*,Auto"
                                                        ColumnSpacing="8">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Instance.Name}" />
                                                            <StackPanel
                                                                Opacity="0.6"
                                                                Orientation="Horizontal"
                                                                Spacing="6">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Text="{Binding Instance.MinecraftVersion}" />
                                                                <TextBlock
                                                                    IsVisible="{Binding Instance.Loader, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                    FontSize="12"
                                                                    Text="·" />
                                                                <TextBlock
                                                                    IsVisible="{Binding Instance.Loader, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                    FontSize="12"
                                                                    Text="{Binding Instance.Loader, Converter={x:Static app:InternalConverters.LoaderToDisplayLabel}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <husk:Tag
                                                            Grid.Column="1"
                                                            Classes="Warning"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding Instance.CorruptReason, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                            <TextBlock
                                                                FontSize="{StaticResource SmallFontSize}"
                                                                Text="{Binding Instance.CorruptReason, Converter={x:Static app:LocalizedEnumConverters.LocalizedCorruptReason}}" />
                                                        </husk:Tag>
                                                    </Grid>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </app:EmptyContainer>
                        </husk:Card>
                    </DockPanel>
                </DataTemplate>
            </husk:PlaceholderContainer.SourceTemplate>

            <DockPanel>
                <husk:ModalActionPanel
                    DockPanel.Dock="Bottom"
                    Layout="Right"
                    Spacing="8">
                    <Button
                        Classes="Primary"
                        IsEnabled="{Binding !IsScanning}"
                        Command="{Binding ScanCommand}"
                        IsDefault="True">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">
                            <fi:SymbolIcon
                                IsVisible="{Binding !IsScanning}"
                                FontSize="{StaticResource MediumFontSize}"
                                Symbol="Search" />
                            <husk:ProgressRing
                                Width="{StaticResource MediumFontSize}"
                                Height="{StaticResource MediumFontSize}"
                                IsVisible="{Binding IsScanning}"
                                IsIndeterminate="True"
                                Theme="{StaticResource SolidProgressRingTheme}" />
                            <TextBlock Text="{x:Static lang:Resources.MigrateModal_Scan}" />
                        </StackPanel>
                    </Button>
                </husk:ModalActionPanel>
                <StackPanel
                    HorizontalAlignment="Stretch"
                    Spacing="12">
                    <TextBlock
                        Opacity="0.7"
                        Text="{x:Static lang:Resources.MigrateModal_Description}"
                        TextWrapping="Wrap" />
                    <TabStrip
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Kinds}"
                        SelectedItem="{Binding SelectedLauncher}">
                        <TabStrip.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </TabStrip.ItemsPanel>
                        <TabStrip.Styles>
                            <Style Selector="TabStripItem">
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </TabStrip.Styles>
                        <TabStrip.ItemTemplate>
                            <DataTemplate x:DataType="app:MigrateLauncherKindModel">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Kind, Converter={x:Static app:LocalizedEnumConverters.LocalizedLauncherKind}}" />
                                    <TextBlock
                                        FontSize="{StaticResource SmallFontSize}"
                                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                        Text="{Binding DefaultDirectory}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </TabStrip.ItemTemplate>
                    </TabStrip>
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="{x:Static lang:Resources.MigrateModal_DirectoryWatermark}"
                            Text="{Binding DataDirectory}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding BrowseCommand}">
                            <fi:SymbolIcon
                                FontSize="{StaticResource MediumFontSize}"
                                Symbol="FolderOpen" />
                        </Button>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </husk:PlaceholderContainer>
    </DockPanel>
</husk:Modal>
