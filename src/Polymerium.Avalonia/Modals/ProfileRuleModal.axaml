<husk:Modal
    x:Class="Polymerium.Avalonia.Modals.ProfileRuleModal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        RowDefinitions="Auto,*,Auto"
        RowSpacing="12">
        <StackPanel Grid.Row="0">
            <TextBlock
                FontSize="{StaticResource LargeFontSize}"
                FontWeight="{StaticResource ControlStrongFontWeight}"
                Text="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_Title}}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <StackPanel Spacing="6">
                    <TextBlock
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_RuleTypeLabelText}}" />
                    <ComboBox
                        ItemsSource="{Binding $parent[app:ProfileRuleModal].SelectorTypes}"
                        SelectedItem="{Binding $parent[app:ProfileRuleModal].Rule.Selector.Type, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{app:LocalizedEnum {Binding}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <husk:SwitchContainer Value="{Binding $parent[app:ProfileRuleModal].Rule.Selector.Type, FallbackValue={x:Null}, Mode=OneWay}">
                        <husk:SwitchCase Value="Pref">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                    Text="{Translate {x:Static app:LanguageManager+Keys.SelectorType_Pref}}" />
                                <TextBox Text="{Binding $parent[app:ProfileRuleModal].Rule.Selector.Pref, Mode=TwoWay}">
                                    <TextBox.InnerLeftContent>
                                        <StackPanel Orientation="Horizontal">
                                            <fi:SymbolIcon
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource MediumFontSize}"
                                                Symbol="Link" />
                                            <husk:Divider Orientation="Vertical" />
                                        </StackPanel>
                                    </TextBox.InnerLeftContent>
                                    <TextBox.InnerRightContent>
                                        <Button Command="{Binding $parent[app:ProfileRuleModal].PickPackageCommand}">
                                            <husk:IconLabel
                                                Icon="Shortpick"
                                                Text="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_PickButtonText}}" />
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>
                        </husk:SwitchCase>
                        <husk:SwitchCase Value="Repository">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                    Text="{Translate {x:Static app:LanguageManager+Keys.SelectorType_Repository}}" />
                                <TextBox Text="{Binding $parent[app:ProfileRuleModal].Rule.Selector.Repository, Mode=TwoWay}">
                                    <TextBox.InnerLeftContent>
                                        <StackPanel Orientation="Horizontal">
                                            <fi:SymbolIcon
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource MediumFontSize}"
                                                Symbol="BuildingRetail" />
                                            <husk:Divider Orientation="Vertical" />
                                        </StackPanel>
                                    </TextBox.InnerLeftContent>
                                </TextBox>
                            </StackPanel>
                        </husk:SwitchCase>
                        <husk:SwitchCase Value="Tag">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                    Text="{Translate {x:Static app:LanguageManager+Keys.SelectorType_Tag}}" />
                                <TextBox Text="{Binding $parent[app:ProfileRuleModal].Rule.Selector.Tag, Mode=TwoWay}">
                                    <TextBox.InnerLeftContent>
                                        <StackPanel Orientation="Horizontal">
                                            <fi:SymbolIcon
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource MediumFontSize}"
                                                Symbol="Tag" />
                                            <husk:Divider Orientation="Vertical" />
                                        </StackPanel>
                                    </TextBox.InnerLeftContent>
                                    <TextBox.InnerRightContent>
                                        <Button Command="{Binding $parent[app:ProfileRuleModal].PickTagCommand}">
                                            <husk:IconLabel
                                                Icon="Shortpick"
                                                Text="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_PickButtonText}}" />
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>
                        </husk:SwitchCase>
                        <husk:SwitchCase Value="Kind">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                    Text="{Translate {x:Static app:LanguageManager+Keys.SelectorType_Kind}}" />
                                <ComboBox
                                    ItemsSource="{Binding $parent[app:ProfileRuleModal].Kinds}"
                                    SelectedItem="{Binding $parent[app:ProfileRuleModal].Rule.Selector.Kind, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{app:LocalizedEnum {Binding}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </husk:SwitchCase>
                        <husk:SwitchCase>
                            <StackPanel Spacing="6">
                                <TextBlock
                                    Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                    Text="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_ChildrenLabelText}}" />
                                <Button
                                    DockPanel.Dock="Right"
                                    Classes="Small"
                                    Command="{Binding $parent[app:ProfileRuleModal].EditSelectorsCommand}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <fi:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource MediumFontSize}"
                                            Symbol="SettingsCogMultiple" />
                                        <TextBlock Text="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_ChildrenEditButtonText}}" />
                                        <TextBlock Foreground="{StaticResource ControlSecondaryForegroundBrush}">
                                            <Run Text="(" />
                                            <Run Text="{Binding $parent[app:ProfileRuleModal].Rule.Selector.Children.Count, FallbackValue=N/A}" />
                                            <Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </husk:SwitchCase>
                    </husk:SwitchContainer>
                </StackPanel>
                <Border
                    Padding="12"
                    Background="{StaticResource ControlTranslucentHalfBackgroundBrush}"
                    CornerRadius="{StaticResource MediumCornerRadius}">
                    <StackPanel Spacing="6">
                        <DockPanel HorizontalSpacing="6">
                            <ToggleSwitch
                                DockPanel.Dock="Right"
                                IsChecked="{Binding $parent[app:ProfileRuleModal].Rule.Skipping, Mode=TwoWay}" />
                            <TextBlock
                                Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                Text="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_SkippingLabelText}}" />
                        </DockPanel>
                        <DockPanel HorizontalSpacing="6">
                            <ToggleSwitch
                                DockPanel.Dock="Right"
                                IsChecked="{Binding $parent[app:ProfileRuleModal].Rule.Normalizing, Mode=TwoWay}" />
                            <TextBlock
                                Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                Text="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_NormalizingLabelText}}" />
                        </DockPanel>
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                Text="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_DestinationLabelText}}" />
                            <TextBox
                                PlaceholderText="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_DestinationPlaceholder}}"
                                Text="{Binding $parent[app:ProfileRuleModal].Rule.Destination, Mode=TwoWay}">
                                <TextBox.InnerRightContent>
                                    <Button
                                        IsVisible="{Binding $parent[TextBox].Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Command="{Binding $parent[TextBox].Clear}">
                                        <fi:SymbolIcon
                                            FontSize="{StaticResource MediumFontSize}"
                                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                                            Symbol="Dismiss" />
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="8">
            <DropDownButton Grid.Column="0">
                <husk:IconLabel
                    Icon="ReceiptSparkles"
                    Text="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_PresetsButtonText}}" />
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuItem
                            Click="TemplateResourcePackButton_OnClick"
                            Header="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_ResourcePackMenuText}}">
                            <MenuItem.Icon>
                                <fi:SymbolIcon
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource MediumFontSize}"
                                    Symbol="FolderZip" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Click="TemplateDataPackButton_OnClick"
                            Header="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_DataPackMenuText}}">
                            <MenuItem.Icon>
                                <fi:SymbolIcon
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource MediumFontSize}"
                                    Symbol="FolderZip" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Click="TemplateTaCZButton_OnClick"
                            Header="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_TaCZGunPackMenuText}}">
                            <MenuItem.Icon>
                                <fi:SymbolIcon
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource MediumFontSize}"
                                    Symbol="Guitar" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Click="TemplatePointBlankButton_OnClick"
                            Header="{Translate {x:Static app:LanguageManager+Keys.ProfileRuleModal_PointBlankGunPackMenuText}}">
                            <MenuItem.Icon>
                                <fi:SymbolIcon
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource MediumFontSize}"
                                    Symbol="Guitar" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button
                Grid.Column="2"
                Command="{Binding $parent[husk:Modal].Dismiss}"
                Content="{Translate {x:Static app:LanguageManager+Keys.Dialog_DismissButtonText}}" />
        </Grid>
    </Grid>
</husk:Modal>
