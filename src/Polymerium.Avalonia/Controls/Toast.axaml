<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:fi="using:FluentIcons.Avalonia"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia">

    <ControlTheme
        x:Key="{x:Type husk:Toast}"
        BasedOn="{StaticResource {x:Type husk:Toast}}"
        TargetType="husk:Toast">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BackgroundSizing="{TemplateBinding BackgroundSizing}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    ClipToBounds="{TemplateBinding ClipToBounds}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid>
                        <app:BlurBackdrop
                            IsVisible="{Binding (app:BlurBackdrop.UseBlur), RelativeSource={RelativeSource TemplatedParent}}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <Panel>
                            <ScrollViewer
                                Name="ScrollViewer"
                                HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </ScrollViewer>
                            <Grid
                                Name="Header"
                                VerticalAlignment="Top"
                                IsVisible="{TemplateBinding IsHeaderVisible}">
                                <Border
                                    Background="{StaticResource FlyoutBackgroundBrush}"
                                    IsHitTestVisible="False"
                                    CornerRadius="{TemplateBinding CornerRadius,
                                                                   Converter={x:Static husk:CornerRadiusConverters.Top}}">
                                    <Border.Opacity>
                                        <MultiBinding
                                            Converter="{x:Static app:InternalConverters.ToastHeaderOpacity}"
                                            ConverterParameter="Background">
                                            <Binding ElementName="ScrollViewer" Path="Offset" />
                                            <Binding ElementName="Header" Path="Bounds.Height" />
                                            <Binding
                                                Path="(app:ToastHeader.RevealOffset)"
                                                RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Opacity>
                                </Border>
                                <DockPanel
                                    Margin="{StaticResource ToastHeaderlessContentMargin}"
                                    HorizontalSpacing="16">
                                    <Button
                                        DockPanel.Dock="Right"
                                        Padding="8"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource ControlBackgroundBrush}"
                                        Command="{Binding Dismiss, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                        CornerRadius="{StaticResource FullCornerRadius}"
                                        IsCancel="True"
                                        AutomationProperties.Name="{Translate {x:Static app:LanguageManager+Keys.Dialog_DismissButtonText}}"
                                        ToolTip.Tip="{Translate {x:Static app:LanguageManager+Keys.Dialog_DismissButtonText}}">
                                        <fi:SymbolIcon
                                            Width="{StaticResource LargeFontSize}"
                                            Height="{StaticResource LargeFontSize}"
                                            Symbol="Dismiss" />
                                    </Button>
                                    <ContentPresenter
                                        IsVisible="{TemplateBinding IsHeaderVisible}"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}">
                                        <ContentPresenter.Opacity>
                                            <MultiBinding Converter="{x:Static app:InternalConverters.ToastHeaderOpacity}">
                                                <Binding
                                                    ElementName="ScrollViewer"
                                                    Path="Offset" />
                                                <Binding
                                                    ElementName="Header"
                                                    Path="Bounds.Height" />
                                                <Binding
                                                    Path="(app:ToastHeader.RevealOffset)"
                                                    RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </ContentPresenter.Opacity>
                                        <ContentPresenter.Styles>
                                            <Style Selector="ContentPresenter &gt; TextBlock">
                                                <Setter Property="FontSize" Value="{StaticResource ExtraLargeFontSize}" />
                                                <Setter Property="FontWeight" Value="{StaticResource ControlStrongFontWeight}" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            </Style>
                                        </ContentPresenter.Styles>
                                    </ContentPresenter>
                                </DockPanel>
                            </Grid>
                        </Panel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[(app|BlurBackdrop.UseBlur)=False]">
            <Setter Property="Background" Value="{StaticResource FlyoutBackgroundBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
