<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:async="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:fi="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia">
    <!--
        组信息徽章：{组类型图标 + 名字}，按 GroupInfoModelBase 实际类型分发。
        组头、选择器 chip 与包行归属徽章共用同一套，保证组类型视觉一致。
    -->
    <DataTemplate x:Key="GroupInfoBadgeTemplate">
        <ContentControl Content="{Binding}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="app:ModpackGroupInfoModel">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Border
                            Width="14"
                            Height="14"
                            Background="{StaticResource ControlTranslucentHalfBackgroundBrush}"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource SmallCornerRadius}">
                            <Border.Background>
                                <ImageBrush
                                    async:ImageBrushLoader.Source="{Binding Thumbnail}"
                                    Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding Name, FallbackValue=Modpack}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="app:RecipeGroupInfoModel">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <fi:SymbolIcon
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Symbol="ListBar" />
                        <TextBlock Text="{Binding Name, FallbackValue=Recipe}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="app:CollectionGroupInfoModel">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <fi:SymbolIcon
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                            Symbol="Collections" />
                        <TextBlock Text="{Binding Name, FallbackValue=Collection}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DataTemplate>
</ResourceDictionary>
