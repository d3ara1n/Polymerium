<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fie="clr-namespace:FluentIcons.Avalonia.Markup;assembly=FluentIcons.Avalonia"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:app="https://github.com/d3ara1n/Polymerium">

    <Style Selector=":is(Window)">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource MainFontFamily}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="ContextFlyout">
            <MenuFlyout>
                <MenuItem
                    IsEnabled="{Binding $parent[TextBox].CanCut}"
                    Command="{Binding $parent[TextBox].Cut}"
                    Header="{Translate {x:Static app:LanguageManager+Keys.Shared_Cut}}"
                    Icon="{fie:SymbolIcon Symbol=Cut,
                                          FontSize={StaticResource MediumFontSize}}"
                    InputGesture="{x:Static TextBox.CutGesture}" />
                <MenuItem
                    IsEnabled="{Binding $parent[TextBox].CanCopy}"
                    Command="{Binding $parent[TextBox].Copy}"
                    Header="{Translate {x:Static app:LanguageManager+Keys.Shared_Copy}}"
                    Icon="{fie:SymbolIcon Symbol=Copy,
                                          FontSize={StaticResource MediumFontSize}}"
                    InputGesture="{x:Static TextBox.CopyGesture}" />
                <MenuItem
                    IsEnabled="{Binding $parent[TextBox].CanPaste}"
                    Command="{Binding $parent[TextBox].Paste}"
                    Header="{Translate {x:Static app:LanguageManager+Keys.Shared_Paste}}"
                    Icon="{fie:SymbolIcon Symbol=ClipboardPaste,
                                          FontSize={StaticResource MediumFontSize}}"
                    InputGesture="{x:Static TextBox.PasteGesture}" />
            </MenuFlyout>
        </Setter>
    </Style>

    <Style Selector="husk|CodeViewer">
        <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
    </Style>
    <Style Selector="husk|DiffView">
        <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
    </Style>
    <Style Selector="husk|HighlightBlock">
        <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
    </Style>


    <Style Selector="husk|Dialog">
        <Setter Property="PrimaryText" Value="{Translate {x:Static app:LanguageManager+Keys.Dialog_ConfirmButtonText}}" />
        <Setter Property="SecondaryText" Value="{Translate {x:Static app:LanguageManager+Keys.Dialog_CancelButtonText}}" />
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="OffContent" Value="{Translate {x:Static app:LanguageManager+Keys.Enum_Off}}" />
        <Setter Property="OnContent" Value="{Translate {x:Static app:LanguageManager+Keys.Enum_On}}" />
    </Style>
</Styles>
