<app:AccountCreationStep
    x:Class="Polymerium.Avalonia.Components.AccountCreationPortal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="https://github.com/d3ara1n/Polymerium"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="320"
    d:DesignWidth="256"
    Header="{Translate {x:Static app:LanguageManager+Keys.AccountCreationPortal_Title}}"
    IsNextAvailable="True"
    mc:Ignorable="d">
    <StackPanel Spacing="12">
        <TabStrip Name="AccountTypeSelectBox">
            <TabStrip.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
            </TabStrip.ItemsPanel>
            <TabStripItem>
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource LargeFontSize}"
                        Text="{Translate {x:Static app:LanguageManager+Keys.AccountCreationPortal_MicrosoftTitle}}" />
                    <TextBlock
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="{Translate {x:Static app:LanguageManager+Keys.AccountCreationPortal_MicrosoftSubtitle}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabStripItem>
            <TabStripItem>
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource LargeFontSize}"
                        Text="{Translate {x:Static app:LanguageManager+Keys.AccountCreationPortal_AuthlibInjectorTitle}}" />
                    <TextBlock
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="{Translate {x:Static app:LanguageManager+Keys.AccountCreationPortal_AuthlibInjectorSubtitle}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabStripItem>
            <TabStripItem>
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource LargeFontSize}"
                        Text="{Translate {x:Static app:LanguageManager+Keys.AccountCreationPortal_TrialTitle}}" />
                    <TextBlock
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="{Translate {x:Static app:LanguageManager+Keys.AccountCreationPortal_TrialSubtitle}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabStripItem>
            <TabStripItem IsEnabled="{Binding $parent[app:AccountCreationPortal].IsOfflineAvailable, FallbackValue=False}">
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource LargeFontSize}"
                        Text="{Translate {x:Static app:LanguageManager+Keys.AccountCreationPortal_OfflineTitle}}" />
                    <TextBlock
                        Foreground="{StaticResource ControlSecondaryForegroundBrush}"
                        Text="{Translate {x:Static app:LanguageManager+Keys.AccountCreationPortal_OfflineSubtitle}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabStripItem>
        </TabStrip>
        <husk:InfoBar
            IsVisible="{Binding $parent[app:AccountCreationPortal].IsOfflineAvailable, Converter={x:Static BoolConverters.Not}, FallbackValue=True}"
            Content="{Translate {x:Static app:LanguageManager+Keys.AccountCreationPortal_Prompt}}" />
    </StackPanel>
</app:AccountCreationStep>
